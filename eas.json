{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development-simulator": {
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true,
        "resourceClass": "medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": true,
        "resourceClass": "medium"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "ios": {
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
