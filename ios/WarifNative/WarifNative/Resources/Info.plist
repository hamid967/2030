<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>وريف</string>
  <key>CFBundleName</key>
  <string>WarifNative</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>

  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key>
    <string></string>
  </dict>

  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>

  <!-- Arabic-first with full RTL. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>ar</string>

  <!-- Coarse, one-shot location only, used to suggest the Saudi region. -->
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>يستخدم وريف موقعك التقريبي مرة واحدة لاقتراح منطقتك وتطبيق الثيم المناسب. لا نحفظ إحداثياتك أو سجل تحركاتك.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>يستخدم وريف الميكروفون عند اختيارك التحدث مع مساعد وريف.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>يحوّل وريف كلامك إلى نص عند اختيارك استخدام المساعد الصوتي.</string>
  <key>WARIF_AI_GATEWAY_URL</key>
  <string>$(WARIF_AI_GATEWAY_URL)</string>
  <key>WARIF_AI_CLOUD_ALLOWED</key>
  <string>$(WARIF_AI_CLOUD_ALLOWED)</string>

  <!-- Read-only Health access, requested only from Connected Health. -->
  <key>NSHealthShareUsageDescription</key>
  <string>يقرأ وريف، بموافقتك، بيانات النبض والنوم والنشاط لعرض أنماط صحية عامة مرتبطة بتسجيلاتك. لا نستخدم هذه البيانات للإعلانات.</string>

  <key>NSFaceIDUsageDescription</key>
  <string>يستخدم وريف Face ID لقفل التطبيق وحماية بياناتك على هذا الجهاز.</string>
</dict>
</plist>
