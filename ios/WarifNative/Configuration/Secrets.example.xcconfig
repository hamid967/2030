// Copy this file to Secrets.xcconfig (git-ignored) and fill in values.
// Only PUBLIC values belong here — never the Supabase service-role key.

// Placeholder bundle identifier (override per environment).
WARIF_BUNDLE_ID = sa.warif.app

// Public Supabase project URL and publishable (anon) key only.
WARIF_SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
WARIF_SUPABASE_ANON_KEY = your-publishable-anon-key
